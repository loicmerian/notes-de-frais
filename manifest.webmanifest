{
  "name": "Notes de frais Elidia",
  "short_name": "Notes de frais",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1f3a5f",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "fichiers", "accept": ["application/pdf", "image/*", ".pdf"] }] }
  }
}
